{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arkahad-mesa",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SALA", "class_name": "Sala" },
      { "name": "SAGUAO", "class_name": "Saguao" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sala", "Saguao"] }
  ],
  "vars": {
    // Cole aqui o "ID do cliente OAuth" do Google para ativar o login com Google.
    // Vazio = login só por apelido.
    "GOOGLE_CLIENT_ID": "",
    // "1" = permite apelido mesmo com Google ativado.
    "PERMITIR_APELIDO": "0"
  },
  "observability": { "enabled": true }
}
